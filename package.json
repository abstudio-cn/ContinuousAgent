{
  "name": "continuous-agent-web",
  "version": "1.0.0",
  "private": true,
  "description": "ContinuousAgent：常驻本机的 TypeScript / 浏览器版通用智能体（agent 循环 + Web UI）",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "dev": "npm run build && node dist/server/index.js",
    "selftest": "node scripts/selftest.mjs",
    "smoke": "node scripts/tool-smoke.mjs",
    "test:history": "node scripts/history-sequence-test.mjs",
    "test:history-400": "node scripts/history-400-repro.mjs",
    "test:exec-timeout": "node scripts/exec-timeout-force-test.mjs",
    "test:native": "node scripts/native-resilience-test.mjs",
    "probe:native": "node scripts/native-probe.mjs",
    "test:plugins": "node scripts/plugin-test.mjs",
    "test:plugins-manage": "node scripts/plugin-manage-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}